/* ═══════════════════════════════════════════════════════════════
   TCG Inventory — Design System (Dark Theme / Umbreon)
   ─────────────────────────────────────────────────────────────
   Mirrors style.qss token structure but with dark palette.
   ═══════════════════════════════════════════════════════════════ */

/* ── Fondos Generales ────────────────────────────────────────── */
QWidget#MainBackground, QWidget#LoginBackground {
    background-color: #121212;
    border-radius: 20px;
}

/* ── Panel lateral ───────────────────────────────────────────── */
QWidget#side {
    background-color: qlineargradient(x1:0 y1:0, x2:0 y2:1,
        stop:0 #1a1a1a, stop:1 #242424);
    border-radius: 16px;
    border: 2px solid #333333;
}

/* ── Área de contenido principal ─────────────────────────────── */
QWidget#content {
    background-color: #1e1e1e;
    border: 2px solid #333333;
    border-radius: 12px;
}

/* ── Botones de Navegación (3 estados: normal -> hover -> activo) ─ */
QPushButton[class="NavButton"] {
    background-color: #3a3a44;
    color: #f1f5f9;
    font-weight: 600;
    font-size: 14px;
    border-radius: 12px;
    border: 2px solid #4c4c59;
    text-align: left;
    padding-left: 14px;
    min-height: 44px;
    max-height: 44px;
}
QPushButton[class="NavButton"]:hover {
    background-color: #2b2b34;
    border-color: #5e5e70;
}
QPushButton[class="NavButton"]:pressed,
QPushButton[class="NavButton"][active="true"] {
    background-color: #181820;
    border-color: #c084fc;
    color: #ffffff;
    font-weight: 700;
}
QPushButton[class="NavButton"][active="true"]:hover {
    background-color: #14141c;
    border-color: #d8b4fe;
}

/* ── Botones Secundarios ─────────────────────────────────────── */
QPushButton[class="ActionSecondary"] {
    background-color: #3b3b4f;
    color: #e0e0e0;
    font-weight: 600;
    font-size: 13px;
    border-radius: 10px;
    border: 2px solid #4d4d66;
    text-align: center;
    min-height: 38px;
    max-height: 38px;
}
QPushButton[class="ActionSecondary"]:hover  { background-color: #4d4d66; border-color: #5e5e7a; }
QPushButton[class="ActionSecondary"]:pressed { background-color: #5e5e7a; border-color: #727291; }

/* ── Botón de Salir ──────────────────────────────────────────── */
QPushButton[class="ExitButton"] {
    background-color: #8b2c2c;
    color: #e0e0e0;
    font-weight: 700;
    font-size: 14px;
    border-radius: 12px;
    border: 2px solid #a63a3a;
    text-align: center;
    min-height: 44px;
    max-height: 44px;
}
QPushButton[class="ExitButton"]:hover  { background-color: #a63a3a; border-color: #c94c4c; }
QPushButton[class="ExitButton"]:pressed { background-color: #c94c4c; border-color: #e56060; }

/* ── Botones de Vista ────────────────────────────────────────── */
QPushButton[class="ViewGrid"] {
    background-color: qlineargradient(x1:0 y1:0, x2:0 y2:1,
        stop:0 #4d4d66, stop:1 #3b3b4f);
    color: #e0e0e0;
    border-radius: 12px;
    font-size: 20px;
    font-weight: 700;
    border: 2px solid #5e5e7a;
    min-width: 44px; max-width: 44px;
    min-height: 44px; max-height: 44px;
}
QPushButton[class="ViewGrid"]:pressed { margin-top: 1px; }

QPushButton[class="ViewList"] {
    background-color: #2b2b2b;
    color: #a0a0a0;
    border-radius: 12px;
    font-size: 20px;
    font-weight: 700;
    border: 2px solid #3a3a3a;
    min-width: 44px; max-width: 44px;
    min-height: 44px; max-height: 44px;
}
QPushButton[class="ViewList"]:pressed { margin-top: 1px; }

/* ── MessageBox Global ───────────────────────────────────────── */
QMessageBox {
    background-color: #1e1e1e;
    border-radius: 16px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 14px;
    color: #e0e0e0;
}
QMessageBox QPushButton {
    background-color: #2b2b2b;
    color: #e0e0e0;
    border-radius: 10px;
    padding: 7px 16px;
    font-weight: 600;
    min-width: 80px;
    min-height: 34px;
    margin: 5px;
    border: 2px solid #3a3a3a;
}
QMessageBox QPushButton:hover  { background-color: #383838; border-color: #4a4a4a; }
QMessageBox QPushButton:pressed { background-color: #4a4a4a; border-color: #5c5c5c; }

/* ── Buscador y Filtros ──────────────────────────────────────── */
QLineEdit[class="SearchInput"] {
    padding: 6px 12px;
    border: 2px solid #3a3a3a;
    border-radius: 10px;
    background-color: #242424;
    color: #e0e0e0;
    font-size: 13px;
    min-height: 36px;
    max-height: 36px;
}
QLineEdit[class="SearchInput"]:focus {
    border-color: #5c5c5c;
    background-color: #2b2b2b;
}

QComboBox[class="FilterCombo"] {
    padding: 4px 10px;
    border: 2px solid #3a3a3a;
    border-radius: 10px;
    background-color: #242424;
    color: #e0e0e0;
    font-weight: 500;
    font-size: 13px;
    min-height: 36px;
    max-height: 36px;
}
QComboBox[class="FilterCombo"]::drop-down { border: none; }
QComboBox[class="FilterCombo"] QAbstractItemView {
    background-color: #242424;
    color: #e0e0e0;
    selection-background-color: #383838;
    selection-color: white;
    border-radius: 6px;
}

/* ── Botón de Sincronización de Precios ──────────────────────── */
QPushButton[class="SyncBtn"] {
    background-color: #0369a1;
    color: #e0e0e0;
    font-weight: 700;
    font-size: 13px;
    border-radius: 10px;
    padding: 4px 14px;
    border: 1.5px solid #38bdf8;
    min-height: 36px;
    max-height: 36px;
}
QPushButton[class="SyncBtn"]:hover    { background-color: #0284c7; }
QPushButton[class="SyncBtn"]:disabled { background-color: #374151; color: #6b7280; }

/* ── Etiqueta de Valor Total del Inventario ──────────────────── */
QLabel[class="ValorTotalLabel"] {
    font-size: 13px;
    font-weight: bold;
    color: #4ade80;
    background-color: rgba(10, 15, 28, 200);
    padding: 4px 12px;
    border-radius: 10px;
    border: 1.5px solid rgba(56, 189, 248, 160);
    min-height: 36px;
    max-height: 36px;
}

/* ── Paginación ──────────────────────────────────────────────── */
QPushButton[class="PaginationBtn"] {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 2px solid #3a3a3a;
    border-radius: 10px;
    padding: 4px 18px;
    font-weight: bold;
    font-size: 13px;
    min-height: 34px;
    max-height: 34px;
}
QPushButton[class="PaginationBtn"]:hover  { background-color: #2b2b2b; border-color: #4a4a4a; }
QPushButton[class="PaginationBtn"]:pressed { background-color: #383838; }
QPushButton[class="PaginationBtn"]:disabled {
    background-color: #1a1a1a;
    color: #505050;
    border-color: #2a2a2a;
}

QLabel[class="PaginationLabel"] {
    color: #a0a0a0;
    font-weight: bold;
    font-size: 13px;
    padding: 0 10px;
}

/* ── Pantalla de Login ───────────────────────────────────────── */
QLineEdit#LoginInput {
    border: 2px solid #3a3a3a;
    border-radius: 10px;
    padding-left: 12px;
    background-color: #242424;
    font-size: 14px;
    color: #e0e0e0;
    min-height: 38px;
}
QLineEdit#LoginInput:focus { border-color: #5c5c5c; background-color: #2b2b2b; }
QPushButton#LoginBtn {
    background-color: #2b2b2b;
    color: #e0e0e0;
    font-weight: bold;
    font-size: 14px;
    border-radius: 12px;
    border: 2px solid #3a3a3a;
    min-height: 42px;
}
QPushButton#LoginBtn:hover  { background-color: #383838; border-color: #4a4a4a; }
QPushButton#LoginBtn:pressed { background-color: #4a4a4a; border-color: #5c5c5c; }

/* ── Botones del Binder ──────────────────────────────────────── */
QPushButton[class="BinderNavBtn"] {
    background-color: #2b2b2b;
    color: #e0e0e0;
    border-radius: 8px;
    padding: 4px 16px;
    font-weight: bold;
    font-size: 13px;
    border: 1px solid #3a3a3a;
    min-height: 34px;
}
QPushButton[class="BinderNavBtn"]:hover { background-color: #383838; }

/* ── Ajustes ─────────────────────────────────────────────────── */
QWidget#ajustes_root { background-color: #242424; border-radius: 14px; border: 1px solid #333333; }
QLabel[class="header"] { color: #e0e0e0; font-weight: 700; font-size: 18px; }
QLabel[class="label_pill"] {
    background: #2b2b2b;
    color: #e0e0e0;
    border-radius: 16px;
    padding: 6px 14px;
    border: 1px solid #3a3a3a;
}

QPushButton[class="pill"] {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 2px solid #3a3a3a;
    border-radius: 14px;
    padding: 2px 10px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton[class="pill"]:hover {
    background-color: #2b2b2b;
    border-color: #4a4a4a;
}
QPushButton[class="pill"]:pressed {
    background-color: #383838;
}
QPushButton[class="pill selected"] {
    background-color: #2e693e;
    color: #ffffff;
    border: 2px solid #4a935c;
    border-radius: 14px;
    padding: 2px 10px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton[class="pill logout_btn"] {
    background-color: #8b3a4c;
    color: #e0e0e0;
    border-color: #b54f68;
}
QPushButton[class="pill logout_btn"]:hover {
    background-color: #a8475c;
    border-color: #c95770;
}

/* ── Sliders (Ajustes) ───────────────────────────────────────── */
QSlider::groove:horizontal { height: 7px; background: #3a3a3a; border-radius: 4px; }
QSlider::handle:horizontal {
    background: #a0a0a0;
    border: 2px solid #808080;
    width: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

/* ── Login Card ──────────────────────────────────────────────── */
QFrame#LoginCard {
    background-color: #1e1e1e;
    border: 2px solid #3a3a3a;
    border-radius: 20px;
}

/* ── Auto-Updater ────────────────────────────────────────────── */
QDialog#UpdateDialog {
    background-color: #1e1e1e;
    border: 2px solid #333333;
    border-radius: 12px;
}
QLabel#UpdateTitle    { font-size: 18px; font-weight: bold; color: #e0e0e0; }
QLabel#UpdateVersions { font-size: 13px; color: #a0a0a0; }
QLabel#UpdateNotesTitle { font-weight: bold; color: #e0e0e0; }
QTextBrowser#UpdateNotesBrowser {
    background-color: #121212;
    border: 1px solid #333333;
    border-radius: 8px;
    color: #e0e0e0;
    padding: 8px;
    font-size: 13px;
}
QProgressBar#UpdateProgressBar {
    border: 2px solid #3a3a3a;
    border-radius: 6px;
    text-align: center;
    background-color: #121212;
    color: #e0e0e0;
    font-weight: bold;
}
QProgressBar#UpdateProgressBar::chunk { background-color: #8b3a4c; width: 20px; }
QLabel#UpdateStatusLabel { font-size: 12px; color: #888888; }
QPushButton#UpdateLaterBtn {
    background-color: #2b2b2b; color: #e0e0e0;
    font-weight: bold; border-radius: 10px;
    border: 1px solid #3a3a3a; min-height: 34px;
}
QPushButton#UpdateLaterBtn:hover { background-color: #383838; }
QPushButton#UpdateNowBtn {
    background-color: #8b3a4c; color: #e0e0e0;
    font-weight: bold; border-radius: 10px;
    border: 2px solid #b54f68; min-height: 34px;
}
QPushButton#UpdateNowBtn:hover { background-color: #a8475c; }

/* ── Tooltip de información de cartas ────────────────────────── */
QToolTip {
    background-color: #0f172a;
    color: #f8fafc;
    border: 2px solid #38bdf8;
    border-radius: 10px;
    padding: 8px;
    font-size: 12px;
}
